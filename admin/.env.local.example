# admin (Next.js) - 環境変数テンプレート
#
# 使い方:
#   cd admin
#   cp .env.local.example .env.local
#   # 実値に書き換え
#
# Next.js が自動で読み込む。yarn dev / yarn start で有効。
# .env.local は .gitignore 済み。

# --- Google Drive サービスアカウント（runner が Drive upload 時に参照） ---
DASHBOARD_GDRIVE_CREDENTIALS_PATH=/Users/akira/work/key/nexus-notes-412407-ad4455fb74b4.json
DASHBOARD_GDRIVE_ARTICLE_FOLDER_ID=1SYXlt3mWyxclvrZG5xXtt7IZ-f8kyihc
DASHBOARD_GDRIVE_REVIEW_FOLDER_ID=14rGRTsfjRzy1KdCV0-oke5pLxnVcjFJ7

# --- iron-session 暗号鍵 ---
# 本番では必ず固定値を設定（未設定だと yarn dev 起動毎にセッション無効化される）
# 32 文字以上のランダム文字列。生成例:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_SECRET_KEY=please-replace-with-32-char-random-string-xxxxxxxxxxxxxxxxxxxxxxxx
