# digi_article_honyaku_cms - 環境変数テンプレート
#
# 使い方:
#   cp .env.example .env
#   # 実値に書き換え
#
# このファイルは run_translate.sh が自動 source する。
# admin (Next.js) は admin/.env.local を別途参照するので、両方を
# 同じ値で揃えるか、root を信頼ソースとして symlink すること。

# --- Google Drive サービスアカウント ---
# 認証 JSON の絶対パス。リポジトリ外（例: ../key/）に配置すること
DASHBOARD_GDRIVE_CREDENTIALS_PATH=/Users/akira/work/key/nexus-notes-412407-ad4455fb74b4.json

# 翻訳作成（英訳 Google Doc 保存先）
DASHBOARD_GDRIVE_ARTICLE_FOLDER_ID=1SYXlt3mWyxclvrZG5xXtt7IZ-f8kyihc

# 翻訳校閲（校閲レポート Google Doc 保存先）
DASHBOARD_GDRIVE_REVIEW_FOLDER_ID=14rGRTsfjRzy1KdCV0-oke5pLxnVcjFJ7

# --- admin DB seed の認証 prefill（yarn seed 時のみ参照） ---
# 上記 DASHBOARD_GDRIVE_CREDENTIALS_PATH と同じ値で OK
DEFAULT_GDRIVE_CREDENTIALS_PATH=/Users/akira/work/key/nexus-notes-412407-ad4455fb74b4.json
